    "viewsWelcome": [
      {
        "view": "devspace.repositories",
        "contents": "Devspaces needs Docker, which is not installed on this computer.",
        "when": "devspace.dockerSetupRequired"
      },
      {
        "view": "devspace.repositories",
        "contents": "1. Install WSL 2, which Docker Desktop needs. Windows asks for administrator permission; restart afterwards.\n[Install WSL 2](command:devspace.dockerSetup.installWsl)",
        "when": "devspace.dockerSetupRequired && isWindows && !devspace.wslReady"
      },
      {
        "view": "devspace.repositories",
        "contents": "1. ✓ WSL 2 is installed.",
        "when": "devspace.dockerSetupRequired && isWindows && devspace.wslReady"
      },
      {
        "view": "devspace.repositories",
        "contents": "Install Docker Desktop with Homebrew or Docker's installer. You see the commands before anything runs. Docker Desktop is free for personal use, education, non-commercial open source, and small businesses; larger companies need a [paid subscription](https://www.docker.com/legal/docker-subscription-service-agreement/).\n[Install Docker](command:devspace.dockerSetup.install)",
        "when": "devspace.dockerSetupRequired && isMac"
      },
      {
        "view": "devspace.repositories",
        "contents": "2. Install Docker Desktop with winget or Docker's installer. You see the commands before anything runs. Docker Desktop is free for personal use, education, non-commercial open source, and small businesses; larger companies need a [paid subscription](https://www.docker.com/legal/docker-subscription-service-agreement/).\n[Install Docker](command:devspace.dockerSetup.install)",
        "when": "devspace.dockerSetupRequired && isWindows"
      },
      {
        "view": "devspace.repositories",
        "contents": "Install Docker Engine from Docker's package repository. You see the commands before anything runs.\n[Install Docker](command:devspace.dockerSetup.install)",
        "when": "devspace.dockerSetupRequired && isLinux"
      },
      {
        "view": "devspace.repositories",
        "contents": "Your repositories appear here once Docker is installed. Devspaces starts Docker when needed.",
        "when": "devspace.dockerSetupRequired && !isLinux"
      },
      {
        "view": "devspace.repositories",
        "contents": "Your repositories appear here once Docker is installed. Devspaces asks to start Docker Engine when needed.",
        "when": "devspace.dockerSetupRequired && isLinux"
      },
      {
        "view": "devspace.repositories",
        "contents": "Sign in with GitHub to see your repositories that have a Dev Container configuration.\n[Sign in with GitHub](command:devspace.signIn)",
        "when": "!devspace.signedIn"
      },
      {
        "view": "devspace.repositories",
        "contents": "Loading your repositories…",
        "when": "devspace.signedIn && !devspace.loaded && !devspace.dockerSetupRequired"
      },
      {
        "view": "devspace.repositories",
        "contents": "No repository with a Dev Container configuration was found.\n[Refresh](command:devspace.refresh)",
        "when": "devspace.signedIn && devspace.loaded && !devspace.loadFailed && !devspace.dockerSetupRequired && !devspace.devspacesOnly"
      },
      {
        "view": "devspace.repositories",
        "contents": "You have no devspace on this Docker engine yet.\n[Show All Repositories](command:devspace.showAllRepositories)",
        "when": "devspace.signedIn && devspace.loaded && !devspace.loadFailed && !devspace.dockerSetupRequired && devspace.devspacesOnly"
      },
      {
        "view": "devspace.repositories",
        "contents": "The repository list could not be loaded. Check the internet connection and try again.\n[Refresh](command:devspace.refresh)\n[Show Log](command:devspace.showLog)",
        "when": "devspace.signedIn && devspace.loadFailed && !devspace.dockerSetupRequired"
      }
    ],
