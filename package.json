      },
      "devspace-monitor-on": {
        "description": "Devspaces: a devspace that another window uses (a monitor switched on).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E002" }
      },
      "devspace-monitor-connected": {
        "description": "Devspaces: the devspace of this window (a monitor switched on, with the connection sign).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E003" }
      },
      "devspace-monitor-remote": {
        "description": "Devspaces: a remote Docker host (a monitor switched off, with the connection sign).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E004" }
      },
      "devspace-monitor-running": {
        "description": "Devspaces: a devspace whose container runs without a window (a monitor switched off, with the play sign).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E005" }
      },
      "devspace-monitor-updating": {
        "description": "Devspaces: a devspace that is being updated, rebuilt or deleted (a monitor switched off, with the clock sign).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E006" }
      },
      "devspace-monitor-no-container": {
        "description": "Devspaces: a devspace whose container is missing (a monitor switched off, with the ring sign).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E007" }
      },
      "devspace-monitor-warning": {
        "description": "Devspaces: a devspace whose workspace volume is missing, or a Docker endpoint that is not supported (a monitor switched off, with the warning sign).",
        "default": { "fontPath": "./resources/icons/devspace-icons.woff", "fontCharacter": "\\E008" }
      }
