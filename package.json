{
  "name": "nimblescape-devspaces",
  "displayName": "nimblescape Devspaces",
  "description": "Open your GitHub repositories in local dev containers with one action.",
  "version": "0.2.0",
  "publisher": "nimblescape",
  "license": "MIT",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/nimblescape-devspaces.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/nimblescape-devspaces/issues"
  },
